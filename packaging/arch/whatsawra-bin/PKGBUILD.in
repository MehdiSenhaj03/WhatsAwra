# Maintainer: Carmine Paolino <carmine@paolino.me>
pkgname=whatsawra-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Fast native WhatsApp client built with Rust and egui"
arch=('x86_64' 'aarch64')
url="https://whatsawra.rocks"
license=('MIT' 'GPL-2.0-only')
install="${pkgname}.install"
# Nothing beyond libc is linked directly; winit and glutin dlopen these at
# startup, and this is a GUI-only application, so all of them have to be
# there for it to run at all.
depends=('alsa-lib' 'libpipewire' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr')
optdepends=('org.freedesktop.secrets: archive encryption key storage'
            'noto-fonts-emoji: colour emoji in messages and reactions'
            'xdg-desktop-portal: the file picker for attachments')
provides=('whatsawra')
conflicts=('whatsawra' 'whatsawra-git')
options=('!debug' '!strip')
_repo="https://github.com/crmne/whatsawra"
source_x86_64=("${_repo}/releases/download/v${pkgver}/whatsawra-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${_repo}/releases/download/v${pkgver}/whatsawra-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local target
  case "$CARCH" in
    x86_64) target="x86_64-unknown-linux-gnu" ;;
    aarch64) target="aarch64-unknown-linux-gnu" ;;
  esac
  local dir="${srcdir}/whatsawra-v${pkgver}-${target}"

  install -Dm755 "${dir}/whatsawra" "${pkgdir}/usr/bin/whatsawra"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/THIRD-PARTY-NOTICES.md" "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.md"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/applications/whatsawra.desktop" \
    "${pkgdir}/usr/share/applications/whatsawra.desktop"
  install -Dm644 "${dir}/packaging/icons/whatsawra.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/whatsawra.svg"
  # Releases predating theme integration remain valid packaging inputs.
  if [[ -f "${dir}/contrib/omarchy/whatsawra.json.tpl" ]]; then
    install -Dm644 "${dir}/contrib/omarchy/whatsawra.json.tpl" \
      "${pkgdir}/usr/share/whatsawra/omarchy/whatsawra.json.tpl"
    install -Dm755 "${dir}/contrib/omarchy/whatsawra-theme" \
      "${pkgdir}/usr/share/whatsawra/omarchy/whatsawra-theme"
  fi

}
